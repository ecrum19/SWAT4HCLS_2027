<file://example.vcf#sample/2/S1/fmt/LAD/item/1> a vcfc:FieldValueItem ;
    vcfc:forAllele <file://example.vcf#record/2/allele/3> ;
    vcfc:itemValue 25 ;
    vcfc:valueIndex 1 .

<file://example.vcf#sample/2/S1/genotype> a vcfc:Genotype ;
    vcfc:genotypeString "0/3"^^vcfc:GenotypeString ;
    vcfc:hasAlleleCall <file://example.vcf#sample/2/S1/genotype/0>,
        <file://example.vcf#sample/2/S1/genotype/1> ;
    vcfc:hasLocalAlleleSet <file://example.vcf#sample/2/S1/local> ;
    vcfc:phasingStatus vcfc:Unphased ;
    vcfc:ploidy 2 .

<file://example.vcf#sample/2/S1/genotype/0> a vcfc:GenotypeAlleleCall ;
    vcfc:callIndex 0 ;
    vcfc:calledAllele <file://example.vcf#record/2/allele/0> ;
    vcfc:isNoCall false ;
    vcfc:phaseIndicator "/" .

<file://example.vcf#sample/2/S1/genotype/1> a vcfc:GenotypeAlleleCall ;
    vcfc:callIndex 1 ;
    vcfc:calledAllele <file://example.vcf#record/2/allele/3> ;
    vcfc:isNoCall false ;
    vcfc:phaseIndicator "/" .

<file://example.vcf#sample/2/S1/local> a vcfc:LocalAlleleSet ;
    vcfc:hasLocalAllele <file://example.vcf#record/2/allele/3> ;
    vcfc:hasLocalAlleleMembership <file://example.vcf#sample/2/S1/local/1> .

<file://example.vcf#sample/2/S1/local/1> a vcfc:LocalAlleleMembership ;
    vcfc:localAllele <file://example.vcf#record/2/allele/3> ;
    vcfc:localIndex 1 .

<file://example.vcf#sample/2/S2> a vcfc:SampleCall ;
    vcfc:forSample <file://example.vcf#samples/S2> ;
    vcfc:hasFormatValue <file://example.vcf#sample/2/S2/fmt/GT>,
        <file://example.vcf#sample/2/S2/fmt/LAA>,
        <file://example.vcf#sample/2/S2/fmt/LAD> ;
    vcfc:hasGenotype <file://example.vcf#sample/2/S2/genotype> ;
