    vcfc:fieldIndex 2 ;
    vcfc:fieldValue "3" ;
    vcfc:fieldValueInteger 3 ;
    vcfc:hasValueItem <file://example.vcf#sample/2/S1/fmt/LAA/item/0> .

<file://example.vcf#sample/2/S1/fmt/LAA/item/0> a vcfc:FieldValueItem ;
